# The second site: The Legend of the Swords on the Heights. Read by slate-sword-legend.service; see "A second site" in
# deploy/pi/README.md. The DM secret is appended on the Pi, not kept here.
#
# SLATE_SITE picks the rooms this process serves from ROOMS in
# server/src/room.rs. A name with no rooms stops it booting.
SLATE_SITE=sword-legend
# 3000 is slate.service and 3001 is the Kindle renderer.
SLATE_ADDR=127.0.0.1:3002
SLATE_CLIENT_DIR=/opt/slate/client
SLATE_MAPS=/var/lib/slate-sword-legend/maps
SLATE_PORTRAITS=/var/lib/slate-sword-legend/portraits
SLATE_BACKDROPS=/var/lib/slate-sword-legend/backdrops
SLATE_TRACKS=/var/lib/slate-sword-legend/tracks
SLATE_STATE=/var/lib/slate-sword-legend/slate-state.json
SLATE_UPLOADS=/var/lib/slate-sword-legend/uploads
RUST_LOG=slate_server=info
