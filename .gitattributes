# install.sh is executed by bash on the Pi, and core.autocrlf is true on the
# build machine. A CR at the end of a line makes bash fail on the wrong line
# number. Deploy-Slate.ps1 strips them again on the way out; this keeps them
# from arriving in the first place.
*.sh text eol=lf

# The same for what systemd reads on the Pi. A CR in an env file ends up inside
# the value, so SLATE_SITE=sword-legend<CR> names no site and the process won't boot.
deploy/pi/*.service text eol=lf
deploy/pi/*.env text eol=lf
