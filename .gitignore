node_modules/
client/dist/
client/testbuild/

# The build stamp Deploy-Slate.ps1 writes for the status page to report. Not
# under client/, because that tree is served statically -- see
# client/status/README.md.
/build.json
target/

# The saved room. It is the group's game, not source.
slate-state.json
slate-state.json.tmp

# The room the browser drivers play with, which the README tells you to make and
# delete. Deliberately a different name from the one above: the drivers erase
# every wall on the board and promote maps over it, and the one thing that must
# never happen is a run pointed at the game.
scratch.json

# Maps the DM uploaded at runtime.
uploads/

# An scp that lost its ":destination" and copied to a local file named
# after the host instead. See deploy/pi/README.md.
*@slate.local

# The book dumps the spell index is built from, and the prose they carry.
# `client/spells/srd.json` is committed because SRD 5.1 is CC-BY; Xanathar's,
# Tasha's and the non-SRD half of the PHB are under no open licence, so the
# header facts go in `extra.json` and the text stays here. The page fetches the
# overlay and does without it. See client/spells/LICENSE-SRD.md.
spells_tmp/
client/spells/text.json
